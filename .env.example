# Settings for running Casa Fida in production. Copy this file to .env, fill it in, build the
# web app (npm run build), then start the server with:
#   node --env-file=.env server/index.ts
# Never commit .env: it holds passwords.

# Serves the built web app too, with security headers and secure cookies.
NODE_ENV=production

# Where people reach the app. Links in emails (like proposal invites) point here.
APP_URL=https://casafida.example.com

# Where the server listens. In a container, use HOST=0.0.0.0.
PORT=3002
HOST=127.0.0.1

# How many proxies (like Caddy or nginx) sit in front of the server, so login limits see each
# visitor's real address. Leave empty if people connect to the server directly.
TRUST_PROXY=1

# The MySQL database (load db/schema.sql into it first). Use a long random password,
# for example from: openssl rand -base64 24
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=casa_fida
DB_PASSWORD=
DB_NAME=casa_fida

# Sending email (proposal invites), as an SMTP address, for example
# smtps://username:password@smtp.example.com:465
# Without it, emails are only written to the server's log.
SMTP_URL=
MAIL_FROM="Casa Fida <no-reply@casafida.example.com>"
