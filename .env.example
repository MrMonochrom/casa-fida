# Settings for running Casa Fida on a server with Docker. Copy this file to .env, fill it in, then
# start everything with:
#   docker compose up -d
# Never commit .env: it holds passwords. See "Running in production" in README.md.

# The address people use, without https://. Point its DNS at this server first: Caddy gets the
# HTTPS certificate for it when it starts. Links in emails point here.
DOMAIN=casafida.example.com

# The MySQL database's passwords: one for the app, one for root (used for backups). Make each a
# long random one, for example with: openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Sending email, as an SMTP address, for example smtps://username:password@smtp.example.com:465
# Without it, emails are only written to the app's log.
SMTP_URL=
MAIL_FROM="Casa Fida <no-reply@casafida.example.com>"

# File storage: a bucket on an S3-compatible service, for photos and the nightly database backups.
# Without it, both stay on this server's disk and are lost if the server is.
# The bucket stays private: the app reads photos from it and checks who's asking.
#   Cloudflare R2:       S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com  S3_REGION=auto
#   Backblaze B2:        S3_ENDPOINT=https://s3.<region>.backblazeb2.com             S3_REGION=<region>, like us-west-004
#   DigitalOcean Spaces: S3_ENDPOINT=https://<region>.digitaloceanspaces.com        S3_REGION=<region>, like fra1
# The access key needs to read, write and delete in the bucket.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Backups go to S3_BUCKET under backups/, or to this bucket instead (same service and key).
# A bucket of their own, with a key that can't delete, is safer if the app's key ever leaks.
BACKUP_BUCKET=
# When to back up each day, in UTC, and how many days of backups to keep.
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=30
# Fetched after each backup, so a monitor (a Sentry cron monitor, Healthchecks.io…) can email you
# when one doesn't happen.
BACKUP_PING_URL=

# Error tracking: errors in the server and in people's browsers go to Sentry, which groups them and
# emails you about new ones. The DSN is under Settings > Projects > (your project) > Client Keys.
SENTRY_DSN=
# Tells this copy's errors apart from another's, like staging.
SENTRY_ENVIRONMENT=production
