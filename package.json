{
  "name": "casa-fida",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,cyan npm:dev:web npm:dev:api",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:start": "sh db/mysql.sh start",
    "db:stop": "sh db/mysql.sh stop",
    "db:status": "sh db/mysql.sh status",
    "db:users": "sh db/mysql.sh users",
    "db:shell": "sh db/mysql.sh shell",
    "db:reset": "sh db/mysql.sh reset",
    "plan": "node server/scripts/set-plan.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.0.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
